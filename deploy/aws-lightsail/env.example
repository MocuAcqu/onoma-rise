# 安裝腳本會複製到 /etc/onoma-rise/recognition.env，請勿提交真實密鑰。

PYTHONUTF8=1
TONNZE_CORS_ORIGINS=https://onoma-rise.onrender.com
RECOGNITION_PROXY_TOKEN=CHANGE_ME
RECOGNITION_REQUIRE_PROXY_TOKEN=1

# Lightsail 的 API 與 worker 共用 MongoDB queue 與 GridFS。
SCORE_STORAGE_BACKEND=mongodb

# 與 Render Node API 使用同一個 Atlas cluster/database，但環境變數必須
# 另外複製到 Lightsail；Render 不會自動把私密變數傳到 AWS。
MONGO_URI=mongodb+srv://APP_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE?retryWrites=true&w=majority
MONGO_DATABASE=YOUR_DATABASE
SCORE_MONGO_JOBS_COLLECTION=recognition_jobs
SCORE_MONGO_RUNTIME_COLLECTION=recognition_runtime
SCORE_MONGO_GRIDFS_BUCKET=recognition_files

# 本機目錄只保留 worker runtime lock；不是持久 queue。
SCORE_DATA_DIR=/var/lib/onoma-rise/recognition
SCORE_DB_PATH=/var/lib/onoma-rise/recognition/jobs.sqlite3

# 2 GB Lightsail 的保守預設。穩定後再個別開啟 OCR 或 YOLO。
SCORE_ENABLE_OCR=0
SCORE_ENABLE_YOLO=0
YOLO_WEIGHTS=/opt/onoma-rise/python-backend/models/fermata-augmentation-dot.pt
YOLO_CONFIDENCE=0.65

SCORE_HOMR_IMAGE_WIDTH=1920
SCORE_AUX_IMAGE_MAX_EDGE=2400
SCORE_HOMR_BATCH_SIZE=2
SCORE_HOMR_ONNX_THREADS=2
SCORE_HOMR_TITLE_OCR=0
SCORE_HOMR_MEMORY_PATCH=1

SCORE_MAX_QUEUE=10
JOB_TIMEOUT_SECONDS=600
RETENTION_SECONDS=86400
HOMR_BIN=

