# Python API 與 Worker 會自動載入此檔案；系統環境變數的優先權較高。

# 允許呼叫辨識 API 的前端網址，多個網址以逗號分隔。
TONNZE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 正式環境必填，內容須與 Render Node 的同名變數完全相同；本機可留空。
RECOGNITION_PROXY_TOKEN=
RECOGNITION_REQUIRE_PROXY_TOKEN=0

# 與會員系統共用同一個 MongoDB Atlas cluster／database。先維持 filesystem，
# 完成連線與回歸測試後再將 SCORE_STORAGE_BACKEND 切成 mongodb。
# 請勿提交真實 URI；密碼中的特殊字元必須先做 URL encoding。
MONGO_URI=
MONGO_DATABASE=YOUR_EXISTING_DATABASE
SCORE_STORAGE_BACKEND=filesystem
SCORE_MONGO_JOBS_COLLECTION=recognition_jobs
SCORE_MONGO_RUNTIME_COLLECTION=recognition_runtime
SCORE_MONGO_GRIDFS_BUCKET=recognition_files

# filesystem 模式的樂譜工作檔與 SQLite queue。
SCORE_DATA_DIR=runtime/recognition
SCORE_DB_PATH=runtime/recognition/jobs.sqlite3

# 可選辨識引擎。低資源環境建議先關閉，再逐一測試開啟。
SCORE_ENABLE_OCR=1
SCORE_ENABLE_YOLO=0
YOLO_WEIGHTS=models/fermata-augmentation-dot.pt
YOLO_CONFIDENCE=0.65

# 樂譜圖片記憶體上限。點陣圖只縮小、不放大；PDF 仍可依上限清晰渲染。
SCORE_HOMR_IMAGE_WIDTH=1920
SCORE_AUX_IMAGE_MAX_EDGE=3200

# HOMR segmentation 小批次可降低 activation 峰值；限制 ONNX 執行緒可避免
# 三個模型各自建立主機核心數量的 worker。內建標題 OCR 預設關閉，因為
# 專案稍後會用獨立 RapidOCR 子行程辨識樂譜文字。
SCORE_HOMR_BATCH_SIZE=2
SCORE_HOMR_ONNX_THREADS=2
SCORE_HOMR_TITLE_OCR=0

# 使用專案內的 uint8 tile 與串流合併；自訂且不相容的 HOMR 執行檔才設為 0。
SCORE_HOMR_MEMORY_PATCH=1

# Queue、辨識逾時與結果保留時間。
SCORE_MAX_QUEUE=20
JOB_TIMEOUT_SECONDS=600
RETENTION_SECONDS=86400

# 通常不用設定；預設使用目前 Python 虛擬環境中的 homr。
HOMR_BIN=
