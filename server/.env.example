# MongoDB Atlas 連線字串，不要提交真實密碼。密碼若含 @、:、/ 等字元，
# 必須先做 URL encoding。Python 辨識服務遷移到 MongoDB 後使用同名變數。
# 範例：mongodb+srv://APP_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_EXISTING_DATABASE?retryWrites=true&w=majority
MONGO_URI=
MONGO_DATABASE=YOUR_EXISTING_DATABASE

# 後端運行的 Port
PORT=5000

# 允許呼叫 API 的前端網址；多個網址以逗號分隔，不要加路徑。
# 正式環境範例：https://example.com,https://www.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 同一台主機透過 Nginx 反向代理時使用 127.0.0.1。
# 若容器需要讓其他容器連入則改成 0.0.0.0。
HOST=127.0.0.1

# 正式環境由 Node 將辨識請求轉送到 Oracle；本機留空，交給 Vite proxy。
RECOGNITION_API_URL=

# Node 與 Oracle Python 必須填入同一組長隨機字串，不可放到前端環境變數。
RECOGNITION_PROXY_TOKEN=
